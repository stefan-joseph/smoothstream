{
  "name": "@smoothstream/react",
  "version": "0.1.0",
  "description": "Deterministic, paced Markdown reveal for React",
  "license": "MIT",
  "keywords": [
    "react",
    "markdown",
    "streaming",
    "llm"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/verify-client-boundary.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@smoothstream/core": "^0.1.0",
    "@smoothstream/styles": "^0.1.0",
    "property-information": "^7.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefan-joseph/smoothstream.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/stefan-joseph/smoothstream/tree/main/packages/react",
  "bugs": {
    "url": "https://github.com/stefan-joseph/smoothstream/issues"
  }
}
